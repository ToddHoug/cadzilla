Name     U48 ;
PartNo   00 ;
Date     11/12/26 ;
Revision 05 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board ;
Location U48 ;
Device   G16V8MS ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/*************************************************************************
 * U48 - GAL16V8, sheet "Video Out"
 *
 * Video clock generation and timing: divides the dot clock CXCLK (Y1)
 * into the ACRTC 2CLK, decodes each display fetch, generates the shift-
 * register load strobes and ~BLANK for the Bt453, and buffers CXCLK out
 * as the pixel clock PCLK. FETCH also gates the frame-buffer and overlay
 * SRAM enables in U55-U57, so the memories are only read on display
 * fetches.
 *
 * Registered mode (G16V8MS): pin 1 is CLK (CXCLK) and pin 11 is /OE
 * (tied to GND, registered outputs always enabled). CXCLK is also on
 * pin 2 for combinatorial use.
 *
 * Speed grade: GAL16V8-7 (7.5 ns) required. PCLK is a combinatorial
 * copy of the 65 MHz dot clock, and the registered outputs must settle
 * well within one PCLK.
 *
 * PCLK (12) is a combinatorial, non-inverted copy of CXCLK taken from
 * pin 2, not a registered output. Routing it through the GAL gives it
 * about the same delay as PLOAD and the other outputs.
 * PCLK and PLOAD leave via 33R series resistors R11/R12.
 *
 * Display fetch decode (HD63484 User Manual Fig 2.1(d), checked against
 * the original scan): ~AS pulses only in display (S/W) and refresh-
 * address (R) cycles, and R cycles only occur while ~HSYNC is low. Idle
 * drawing-possible slots and porch cycles have no ~AS. So a memory cycle
 * with ~AS low, ~DRAW high and ~HSYNC high is a display fetch. ~DISP1 is
 * NOT used: it lags the fetches by one memory cycle (single) or two
 * (interleaved), tracking when a word is displayed, not fetched.
 *
 * One display fetch = 8 banks x 16 bits = 16 pixels, loaded into the
 * 74F676s by a one-PCLK PLOAD pulse at the end of the MCYC-high (data)
 * half of the fetch cycle. The 74F676 loads on the falling PCLK edge in
 * the middle of that pulse. Cycles without a fetch don't load, and leave
 * BLANK set, so any word that wasn't fetched is black.
 *
 * BLANK follows the loads one PCLK late (rev 05): it changes on the edge
 * that ends PLOAD. Measured on board B, 640x480 interleaved and 1024x768
 * single: with BLANK changing on the same edge as PLOAD, the Bt453 showed
 * BLANK one pixel ahead of the data. The leftmost pixel of every line was
 * the 74F676 serial-in zeros, shown before the falling PCLK edge that
 * loads the word, and the rightmost pixel was blanked.
 *
 * Race on revision 1 boards: the Bt453 latches BLANK on the same rising
 * PCLK edge that changes it. That works only because PCLK, loaded by the
 * nine 74F676s and the Bt453, reaches the Bt453 later than the lightly
 * loaded BLANK does (measured on board B; good at 640x480 and 1024x768).
 * The margin is that skew less the Bt453 setup time, and is not designed
 * in. Inverting PCLK here would move the race to PLOAD at the 74F676s.
 *
 * Revision 2 boards: the Bt453 CLOCK will come from the oscillator
 * through a single inverter, not from PCLK. The Bt453 then latches on the
 * edge that shifts the 74F676s, so BLANK gets half a PCLK of setup and
 * hold and the pixels a full PCLK. These equations stay as they are.
 *   AMODE = 0 (single):      2CLK = PCLK/8, memory cycle = 16 PCLK,
 *                            count = TWOCLK:PCLK4:PCLK2 (0..7 per half).
 *   AMODE = 1 (interleaved): 2CLK = PCLK/4, memory cycle = 8 PCLK,
 *                            count = TWOCLK:PCLK2 (0..3 per half); use
 *                            only when PCLK < 32 MHz. A word lasts two
 *                            memory cycles, so PCLK4 is reused as PREV
 *                            ("the previous memory cycle loaded") to keep
 *                            BLANK clear for the second one.
 * MCYC toggles after each 2CLK falling edge (<= 40 ns, HD63484-8).
 *
 * FETCH capture: ~AS is a pulse in the address half, so FETCH is set at
 * any clock edge that sees it. ~AS must be low for one PCLK + 5 ns
 * (20 ns at 65 MHz, 30 ns at 40 MHz, 45 ns at 25.175 MHz interleaved).
 * The datasheet minimum is 30 ns; the manual's figures show ~AS low for
 * about the first 2CLK-low phase, so check it on hardware at 25.175 MHz.
 * FETCH is cleared in the data half if ~DRAW or ~HSYNC is low (both have
 * settled by then), and otherwise holds until the edge after PLOAD, so
 * the SRAMs keep driving while the 74F676s load.
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 10/02/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = CXCLK     ; /* Y1 oscillator OUT (register clock)                      */
PIN 2  = CXCLK_I   ; /* net CXCLK - same clock; drives PCLK combinatorially     */
PIN 3  = !DISP1    ; /* net ~{DISP1} - ACRTC ~DISP1 (U1 pin 63); spare, unused  */
PIN 4  = !HSYNC    ; /* net ~{HSYNC} - ACRTC ~HSYNC (U1 pin 12)                 */
PIN 5  = MCYC      ; /* ACRTC MCYC (U1 pin 52)                                  */
PIN 6  = AMODE     ; /* U41 74LS273 Q2 (pin 6)                                  */
PIN 7  = OLEN      ; /* U41 74LS273 Q3 (pin 9)                                  */
PIN 8  = !AS       ; /* net ~{AS} - ACRTC ~AS (U1 pin 53)                       */
PIN 9  = !DRAW     ; /* net ~{DRAW} - ACRTC ~DRAW (U1 pin 54)                   */
/* PIN 11 = /OE, tied to GND                                              */

/* ---- Outputs ---- */
PIN 12 = PCLK      ; /* via R11 -> 74F676 U2-U10 CP, Bt453 CLOCK (U47 pin 23)   */
PIN 13 = !BLANK    ; /* net ~{BLANK} - Bt453 ~BLANK (U47 pin 21)                */
PIN 14 = TWOCLK    ; /* net 2CLK - ACRTC 2CLK (U1 pin 50), U55-U58 pin 1        */
PIN 15 = PCLK4     ; /* no other connection: /4 bit (single), PREV (interleaved) */
PIN 16 = PCLK2     ; /* no other connection (divider state)                     */
PIN 17 = FETCH     ; /* net FETCH -> U55-U58 pin 9: display fetch this cycle    */
PIN 18 = OLPLOAD   ; /* net OLPLOAD - 74F676 U6 LD (pin 5)                      */
PIN 19 = PLOAD     ; /* via R12 -> 74F676 U2-U5,U7-U10 LD (pin 5)               */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

/* Dot-clock divider. 2CLK is high for the upper half of the count and
 * falls when it wraps to 0. In interleaved mode TWOCLK alone divides by
 * 4 and PCLK4 is free to act as PREV. */
PCLK2.D  = !PCLK2 ;
TWOCLK.D = !AMODE & (TWOCLK $ (PCLK4 & PCLK2))   /* PCLK/8 */
         #  AMODE & (TWOCLK $ PCLK2) ;           /* PCLK/4 */

/* Load points: the PCLK before the last one of the MCYC-high (data)
 * half, so PLOAD is high for that last PCLK.
 *   E0: single,      count 6 of 0..7.
 *   E1: interleaved, count 2 of 0..3. */
E0 = !AMODE & MCYC & TWOCLK & PCLK4 & !PCLK2 ;
E1 =  AMODE & MCYC & TWOCLK & !PCLK2 ;
LD = (E0 # E1) & FETCH ;

/* Display fetch flag (see header). */
FETCH.D  = AS
         # FETCH & !PLOAD & !MCYC
         # FETCH & !PLOAD & !DRAW & !HSYNC ;

PLOAD.D   = LD ;
OLPLOAD.D = LD & OLEN ;                 /* OLEN = 0: U6 shifts in zeros */

/* Blank points: one PCLK after the load points, the last PCLK of the
 * data half (count 7 single, count 3 interleaved). PLOAD is high there
 * if this memory cycle loaded. */
B0 = !AMODE & MCYC & TWOCLK & PCLK4 & PCLK2 ;
B1 =  AMODE & MCYC & TWOCLK & PCLK2 ;

/* PCLK4: divider bit in single mode; PREV in interleaved mode, recording
 * at each blank point whether that memory cycle loaded. */
PCLK4.D  = !AMODE & (PCLK4 $ PCLK2)
         #  AMODE & (B1 & PLOAD # !B1 & PCLK4) ;

/* BLANK: cleared on the edge that ends PLOAD, one PCLK after the load
 * strobe starts, so it changes together with the first pixel at the
 * Bt453. At a blank point without a load it is set, except in interleaved
 * mode right after a loaded cycle (PREV), when the word fetched in that
 * cycle is still shifting out. PREV is updated on the same edge, so it
 * still holds the previous memory cycle here. */
BLANK.D  = B0 & !PLOAD
         # B1 & !PCLK4 & !PLOAD
         # BLANK & !PLOAD ;

/* Pixel clock: combinatorial copy of CXCLK */
PCLK     = CXCLK_I ;
