Name     U48 ;
PartNo   00 ;
Date     10/01/26 ;
Revision 02 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board ;
Location U48 ;
Device   G16V8MS ;

/*************************************************************************
 * U48 - GAL16V8, sheet "Video Out"
 *
 * Video clock generation and timing: divides the dot clock CXCLK (Y1)
 * into the ACRTC 2CLK and the shift-register load strobes, generates
 * ~BLANK for the Bt453, and buffers CXCLK out as the pixel clock PCLK.
 *
 * Registered mode (G16V8MS): pin 1 is CLK (CXCLK) and pin 11 is /OE
 * (tied to GND, registered outputs always enabled). CXCLK is also on
 * pin 2 for combinatorial use.
 *
 * PCLK (12) is a combinatorial, non-inverted copy of CXCLK taken from
 * pin 2, not a registered output. Routing it through the GAL gives it
 * about the same delay as PLOAD and the other outputs.
 * PCLK2 (16), PCLK4 (15) and TWOCLK (14) form the dot-clock divider;
 * PCLK2/PCLK4 go nowhere else. SLOT (17, unconnected) is a buried
 * register holding the interleaved-mode display-slot phase.
 * PCLK and PLOAD leave via 33R series resistors R11/R12.
 *
 * One display fetch = 8 banks x 16 bits = 16 pixels, loaded into the
 * 74F676s by a one-PCLK PLOAD pulse at the end of the MCYC-high (data)
 * half of the display memory cycle. The 74F676 loads on the falling
 * PCLK edge in the middle of that pulse.
 *   AMODE = 0 (single):      2CLK = PCLK/8, memory cycle = 16 PCLK,
 *                            every memory cycle is a display slot.
 *   AMODE = 1 (interleaved): 2CLK = PCLK/4, memory cycle = 8 PCLK,
 *                            display and drawing slots alternate; use
 *                            only when PCLK < 32 MHz. SLOT tracks which
 *                            slot is which; it is corrected by any
 *                            ~DRAW-low cycle (always a drawing slot) and
 *                            by the first DISP1-active cycle of a line
 *                            (always a display slot).
 * MCYC toggles after each 2CLK falling edge (<= 40 ns, HD63484-8).
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 10/01/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = CXCLK     ; /* Y1 oscillator OUT (register clock)                      */
PIN 2  = CXCLK_I   ; /* net CXCLK - same clock; drives PCLK combinatorially     */
PIN 3  = !DISP1    ; /* net ~{DISP1} - ACRTC ~DISP1 (U1 pin 63)                 */
PIN 4  = !DISP2    ; /* net ~{DISP2} - ACRTC ~DISP2 (U1 pin 62)                 */
PIN 5  = MCYC      ; /* ACRTC MCYC (U1 pin 52)                                  */
PIN 6  = AMODE     ; /* U41 74LS273 Q2 (pin 6)                                  */
PIN 7  = OLEN      ; /* U41 74LS273 Q3 (pin 9)                                  */
PIN 8  = !DRAW     ; /* net ~{DRAW} - ACRTC ~DRAW (U1 pin 54)                   */
/* PIN 11 = /OE, tied to GND                                              */

/* ---- Outputs ---- */
PIN 12 = PCLK      ; /* via R11 -> 74F676 U2-U10 CP, Bt453 CLOCK (U47 pin 23)   */
PIN 13 = !BLANK    ; /* net ~{BLANK} - Bt453 ~BLANK (U47 pin 21)                */
PIN 14 = TWOCLK    ; /* net 2CLK - ACRTC 2CLK (U1 pin 50), U55-U58 pin 1        */
PIN 15 = PCLK4     ; /* no other connection (divider state)                     */
PIN 16 = PCLK2     ; /* no other connection (divider state)                     */
PIN 17 = SLOT      ; /* unconnected; buried interleaved display-slot register   */
PIN 18 = OLPLOAD   ; /* net OLPLOAD - 74F676 U6 LD (pin 5)                      */
PIN 19 = PLOAD     ; /* via R12 -> 74F676 U2-U5,U7-U10 LD (pin 5)               */
/* PIN 9 = unconnected */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

/* Dot-clock divider. Count = TWOCLK:PCLK4:PCLK2 (single) or PCLK4:PCLK2
 * (interleaved); 2CLK is high for the upper half of the count and
 * falls when it wraps to 0. */
PCLK2.D  = !PCLK2 ;
PCLK4.D  = PCLK4 $ PCLK2 ;
TWOCLK.D = !AMODE & (TWOCLK $ (PCLK4 & PCLK2))   /* PCLK/8 */
         #  AMODE & (PCLK4 $ PCLK2) ;            /* PCLK/4 */

/* Load point: the PCLK before the last one of the MCYC-high (data) half,
 * so PLOAD is high for that last PCLK.
 *   Single:      count 6 of 0..7, every memory cycle.
 *   Interleaved: count 2 of 0..3 (E1), display slot only. SLOT says
 *     whether this memory cycle is the display slot. Two events fix the
 *     phase:
 *       - a ~DRAW-low cycle is always a drawing slot: no load, and the
 *         next memory cycle is the display slot;
 *       - the first DISP1-active cycle while BLANK is still set is always
 *         a display slot (DSK = 0; the ACRTC counts horizontal timing in
 *         whole display cycles), so it loads, re-locking every line.
 *     An idle drawing slot keeps ~DRAW high, so ~DRAW alone can't set
 *     the phase. */
L0 = !AMODE & MCYC & TWOCLK & PCLK4 & !PCLK2 ;
E1 =  AMODE & MCYC & PCLK4 & !PCLK2 ;
L1 = E1 & !DRAW & (SLOT # DISP1 & BLANK) ;
LD = L0 # L1 ;

PLOAD.D   = LD ;
OLPLOAD.D = LD & OLEN ;                 /* OLEN = 0: U6 shifts in zeros */

/* BLANK samples DISP1 for the word being loaded and holds it for the 16
 * pixels of that word. Hold terms are written out so the sum fits in the
 * eight product terms of a registered output. */
BLANK.D  = L0 & !DISP1
         # E1 & !DRAW & SLOT & !DISP1
         # BLANK & !MCYC
         # BLANK & !PCLK4
         # BLANK & PCLK2
         # BLANK & !AMODE & !TWOCLK
         # BLANK & AMODE & !SLOT & !DISP1
         # BLANK & AMODE & DRAW ;

/* At each interleaved load point: the next memory cycle is the display
 * slot unless this one loaded. */
SLOT.D   = E1 & DRAW
         # E1 & !SLOT & !DISP1
         # E1 & !SLOT & !BLANK
         # SLOT & !E1 ;

/* Pixel clock: combinatorial copy of CXCLK */
PCLK     = CXCLK_I ;
