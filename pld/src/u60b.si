/************************************************************************
 * U60 test vectors - I/O decode latch, VSYNC polarity, DAC clock
 * Values are pin levels, from a behaviour model. IODEC is a latch, so
 * the vectors run in order: whole bus cycles, with the address and
 * IODEC8 moving on to the next cycle while the latch is closed.
 * VSPOL, ~VSYNC and CXCLK change on every vector.
 ************************************************************************/

ORDER: SA8, SA9, SA10, SA11, SA12, SA13, SA14, SA15, !EN16, IODEC8, VSPOL, !VSYNC_IN, pSYNC, !pSTVAL, CXCLK, %1, VSYNC, IODEC, DACPCLK;

VECTORS:
