/*************************************************************************
 * U54 - GAL16V8, sheet "Memory Interface" (revision B boards)
 *
 * Overlay SRAM (U19) address mux, bits OA12-OA16. One of three (U52-U54)
 * that give U19 its address A0-A16, selected by OADISP from U55:
 *   OADISP = 0: OA0-OA15 = MA0-MA15, OA16 = OLSEL (U41 Q4). Drawing:
 *               the overlay is one 1bpp bank of a CHR screen.
 *   OADISP = 1: OA0-OA16 = MA3-MA19. Display: the frame buffer always
 *               runs GAI = 8, so the display address is shifted down 3.
 *
 * Simple mode (G16V8AS): combinatorial outputs, always driven, no
 * feedback. Pins 15 and 16 are output-only; pin 11 is an input.
 *
 * Compile with no minimization (cupl -m0): the third product term of
 * each output is logically redundant and only keeps the output steady
 * as OADISP changes while both sources agree, so a minimizer would
 * remove it.
 *
 * Speed grade: GAL16V8-15 (15 ns) or faster.
 *
 * Pin/net assignments taken from the KiCad schematic, 11/13/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = MA12      ; /* latched ACRTC address MA12                                 */
PIN 2  = MA13      ; /* latched ACRTC address MA13                                 */
PIN 3  = MA14      ; /* latched ACRTC address MA14                                 */
PIN 4  = MA15      ; /* latched ACRTC address MA15                                 */
PIN 5  = MA16      ; /* latched ACRTC address MA16                                 */
PIN 6  = MA17      ; /* latched ACRTC address MA17                                 */
PIN 7  = MA18      ; /* latched ACRTC address MA18                                 */
PIN 8  = MA19      ; /* latched ACRTC address MA19                                 */
PIN 9  = OLSEL     ; /* U41 74LS273 Q4: overlay half for a CHR screen              */
PIN 11 = OADISP    ; /* U55 pin 15: 1 = display address (>> 3)                     */

/* ---- Outputs ---- */
PIN 14 = OA16      ; /* overlay SRAM U19 A16                                       */
PIN 15 = OA15      ; /* overlay SRAM U19 A15                                       */
PIN 16 = OA14      ; /* overlay SRAM U19 A14                                       */
PIN 17 = OA13      ; /* overlay SRAM U19 A13                                       */
PIN 18 = OA12      ; /* overlay SRAM U19 A12                                       */
/* PIN 12, PIN 13, PIN 19 = unconnected */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

OA12 = !OADISP & MA12 # OADISP & MA15 # MA12 & MA15 ;
OA13 = !OADISP & MA13 # OADISP & MA16 # MA13 & MA16 ;
OA14 = !OADISP & MA14 # OADISP & MA17 # MA14 & MA17 ;
OA15 = !OADISP & MA15 # OADISP & MA18 # MA15 & MA18 ;
OA16 = !OADISP & OLSEL # OADISP & MA19 # OLSEL & MA19 ;
