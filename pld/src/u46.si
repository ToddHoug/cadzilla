Revision 05 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board ;
Location U46 ;
Device   G16V8MA ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/************************************************************************
 * U46 test vectors - S-100 buffers, MODE write, Bt453 register select
 * Values are pin levels, from a behaviour model of the rev 05 equations.
 * IODECQ and BLK are latches, so the vectors run in order: each
 * combination follows an idle vector at the same address, and the last
 * part runs whole bus cycles: ACRTC writes ending on pWR*, the other
 * ports not, and fetches that decode under stale I/O status, from other
 * ports and from the board's own.
 ************************************************************************/

ORDER: SA2, SA1, SA0, !pWR, pDBIN, sOUT, sINP, !SXTRQ, IODEC, %1, !DH2LEN, !DHDEN, !DLDEN, HDIR, !CTRL_WR, BLK, DAC_A0, IODECQ;

