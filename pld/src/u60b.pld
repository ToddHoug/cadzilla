Name     U60B ;
PartNo   00 ;
Date     11/13/26 ;
Revision 01 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board, rev B ;
Location U60 ;
Device   G16V8MA ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/*************************************************************************
 * U60 - GAL16V8, sheet "S100 Interface" (revision B boards)
 *
 * Board I/O decode latch: adds the high address byte (A8-A15, 16-bit I/O
 * enable) to U61's IODEC8 and latches the result with pSYNC and p~STVAL,
 * as IEEE 696 recommends (2.5.2.2, 2.7.2). Also the VSYNC output polarity
 * select for the VGA connector and the inverted dot clock for the Bt453.
 *
 * Complex mode (G16V8MA): IODEC needs its pin's feedback, and pins 14,
 * 16, 17 and 18 are used as inputs. Pins 12 and 19 are output-only.
 *
 * Compile with no minimization (cupl -m0): the last two product terms of
 * the IODEC latch are logically redundant and only cover the hazard as
 * the latch closes, so a minimizer would remove them.
 *
 * Speed grade: GAL16V8-7 (7.5 ns) required. DACPCLK is a combinatorial,
 * inverted copy of the dot clock, and must reach the Bt453 with about the
 * same delay as U48 (also a -7) gives the shift-register clock PCLK.
 * DACPCLK leaves via the 33R series resistor R13.
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 11/13/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = SA8       ; /* S-100 A8 (P1 pin 84)                                    */
PIN 2  = SA9       ; /* S-100 A9 (P1 pin 34)                                    */
PIN 3  = SA10      ; /* S-100 A10 (P1 pin 37)                                   */
PIN 4  = SA11      ; /* S-100 A11 (P1 pin 87)                                   */
PIN 5  = SA12      ; /* S-100 A12 (P1 pin 33)                                   */
PIN 6  = SA13      ; /* S-100 A13 (P1 pin 85)                                   */
PIN 7  = SA14      ; /* S-100 A14 (P1 pin 86)                                   */
PIN 8  = SA15      ; /* S-100 A15 (P1 pin 32)                                   */
PIN 9  = !EN16     ; /* net ~{EN16} - SW1-7 / RN1 pull-up: 16-bit I/O addressing */
PIN 11 = IODEC8    ; /* U61 pin 12: A7-A3 match in an I/O cycle                 */
PIN 13 = VSPOL     ; /* U41 74LS273 Q1                                          */
PIN 14 = !VSYNC_IN ; /* net ~{VSYNC} - ACRTC ~VSYNC (U1 pin 13)                 */
PIN 16 = pSYNC     ; /* S-100 pSYNC (P1 pin 76)                                 */
PIN 17 = !pSTVAL   ; /* net p~{STVAL} - S-100 p~STVAL (P1 pin 25)               */
PIN 18 = CXCLK     ; /* Y1 oscillator OUT (dot clock)                           */

/* ---- Outputs ---- */
PIN 12 = VSYNC     ; /* VGA connector VSYNC                                     */
PIN 15 = IODEC     ; /* latched board I/O decode -> U45 and U46 pin 11          */
PIN 19 = DACPCLK   ; /* via R13 -> Bt453 CLOCK (U47 pin 23)                     */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

/* Board I/O match, before the latch. IODEC8 already holds A7-A3 and
 * sINP/sOUT. With ~EN16 asserted (SW1-7 on), A8-A15 must also be 00h. */
HI00     = !SA8 & !SA9 & !SA10 & !SA11 & !SA12 & !SA13 & !SA14 & !SA15 ;
DEC      = IODEC8 & !EN16
         # IODEC8 & HI00 ;

/* IODEC latch. It follows DEC while pSYNC and p~STVAL are both high, and
 * holds from the falling edge of p~STVAL, when the standard guarantees
 * the address and status stable, until both are high again in the next
 * bus cycle. So IODEC:
 *   - is up early in the cycle, before p~STVAL, in time for U45 to pull
 *     RDY low;
 *   - does not move when the address and status change at the end of the
 *     cycle, or in the first part of the next one.
 * On an 8080 CPU card p~STVAL is PHI1, and the latch is open for the
 * PHI1 pulse inside SYNC, which is also when the CPU card strobes out
 * the status byte.
 *
 * The last two terms cover the hazard as the latch closes. */
IODEC    = DEC & pSYNC & !pSTVAL
         # IODEC & !pSYNC
         # IODEC & pSTVAL
         # IODEC & IODEC8 & !EN16
         # IODEC & IODEC8 & HI00 ;

/* VGA sync polarity: VSPOL = 1 gives a negative (active-low) pulse,
 * 0 a positive one. VSYNC_IN is true while the ACRTC sync is active. */
VSYNC    = VSYNC_IN & !VSPOL # !VSYNC_IN & VSPOL ;

/* Bt453 clock: the dot clock inverted. The Bt453 then latches on the
 * edge that shifts the 74F676s, half a PCLK from the edge that changes
 * ~BLANK. */
DACPCLK  = !CXCLK ;

IODEC.OE   = 'b'1 ;
VSYNC.OE   = 'b'1 ;
DACPCLK.OE = 'b'1 ;
