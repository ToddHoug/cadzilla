0001101111 ZLHLLHHH  /* in +0 after: strobe */
0001101101 ZLHZHHHH  /* in +0 after: ~DTACK */
0001001101 ZHHZHHHH  /* in +0 after: strobe ends */
0001001111 ZHHZHHHH  /* in +0 after: ~DTACK released */
0001000111 ZHHZHHHH  /* in +0 after: status gone, IODEC still held */
0001000110 ZHHZLHHH  /* in +0 after: IODEC falls */
0101000110 ZHHZLHHH  /* out +2 after: idle */
0101010111 ZHLLLHHH  /* out +2 after: IODEC and status, no strobe */
0100010111 ZLLLLHHH  /* out +2 after: strobe */
0100010101 ZLLZHHHH  /* out +2 after: ~DTACK */
0101010101 ZHLZHHHH  /* out +2 after: strobe ends */
0101010111 ZHLZHHHH  /* out +2 after: ~DTACK released */
1111010111 ZHLZHHHL  /* out +2 after: next address 7, stale status */
0101010111 ZHLZHHHH  /* out +2 after: next address 2 again (A0, A2 glitch) */
0101000111 ZHHZHHHH  /* out +2 after: status gone, IODEC still held */
0101000110 ZHHZLHHH  /* out +2 after: IODEC falls */
