/************************************************************************
 * U45 test vectors - ACRTC and Bt453 strobes, RDY, SIXTN
 * Values are pin levels, from a behaviour model. DONE is a latch, so the
 * vectors run in order: whole bus cycles, each ending with the address
 * moving on while IODEC is still held. Z = not driven.
 ************************************************************************/

ORDER: SA2, SA1, SA0, !pWR, pDBIN, sOUT, sINP, !SXTRQ, !DTACK, IODEC, %1, !SIXTN, !CRT_CS, CRT_RW, RDY, DONE, !DAC_WR, !DAC_RD, !DAC_CS;

