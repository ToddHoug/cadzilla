Name     U46B ;
PartNo   00 ;
Date     11/13/26 ;
Revision 01 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board, rev B ;
Location U46 ;
Device   G16V8AS ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/*************************************************************************
 * U46 - GAL16V8, sheet "S100 Interface" (revision B boards)
 *
 * S-100 bus control: host data-buffer enables/direction (U38-U40
 * 74F245), control-latch write (U41 74LS273), and buffers for A0, A1 and
 * reset, so that the ACRTC and the Bt453 have no pin directly on the bus.
 *
 * IODEC comes from U60: the board's address in an I/O cycle, latched for
 * the whole bus cycle.
 *
 * Simple mode (G16V8AS): combinatorial outputs, always driven, no
 * feedback. Pins 15 and 16 are output-only; pin 11 is an input.
 *
 * Speed grade: GAL16V8-15 (15 ns) or faster.
 *
 * ~DLDEN, ~DHDEN and ~DH2LEN drive the active-low 74F245 ~OE inputs.
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 11/13/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = SA2       ; /* S-100 A2 (P1 pin 81)                                    */
PIN 2  = SA1       ; /* S-100 A1 (P1 pin 80)                                    */
PIN 3  = SA0       ; /* S-100 A0 (P1 pin 79)                                    */
PIN 4  = !pWR      ; /* net p~{WR} - S-100 p~WR (P1 pin 77)                     */
PIN 5  = pDBIN     ; /* S-100 pDBIN (P1 pin 78)                                 */
PIN 6  = sOUT      ; /* S-100 sOUT (P1 pin 45)                                  */
PIN 7  = sINP      ; /* S-100 sINP (P1 pin 46)                                  */
PIN 8  = !SXTRQ    ; /* net ~{SXTRQ} - S-100 ~SXTRQ (P1 pin 58)                 */
PIN 9  = !RESET    ; /* net ~{RESET} - S-100 ~RESET (P1 pin 75)                 */
PIN 11 = IODEC     ; /* latched board I/O decode from U60 pin 15                */

/* ---- Outputs ---- */
PIN 12 = !DH2LEN   ; /* net ~{DH2LEN} - 74F245 U40 ~OE: HD0-7 -> DI             */
PIN 13 = !DHDEN    ; /* net ~{DHDEN} - 74F245 U39 ~OE: DI <-> HD8-15            */
PIN 14 = !DLDEN    ; /* net ~{DLDEN} - 74F245 U38 ~OE: DO <-> HD0-7             */
PIN 15 = HDIR      ; /* 74F245 U38/U39/U40 DIR; 1 = S-100 -> HD                 */
PIN 16 = !RES      ; /* net ~{RES} - ACRTC ~RES, U41 ~MR, SW1-6                 */
PIN 17 = !CTRL_WR  ; /* net ~{CTRL_WR} - U41 74LS273 CP                         */
PIN 18 = B_SA1     ; /* buffered A1: ACRTC RS (U1 pin 5), Bt453 C1 (U47 pin 25) */
PIN 19 = B_SA0     ; /* buffered A0: Bt453 C0 (U47 pin 24)                      */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

X16     = SXTRQ & !SA2 & SA1 & !SA0 ;      /* 16-bit transfer to +2 only   */
RDEN    = IODEC & sINP & pDBIN ;           /* slave may drive DI/DO now    */

/* The write buffers are on for the whole write cycle, not only p~WR, so
 * they still drive the ACRTC's data pins when its CS rises. */
WRSEL   = IODEC & sOUT ;

/* Buffered address bits. B_SA1 is the ACRTC's RS: it leaves here and CS
 * leaves U45, one GAL delay each from the bus, so RS still outlasts CS by
 * about the bus address hold time. */
B_SA0   = SA0 ;
B_SA1   = SA1 ;

/* Reset: a plain buffer */
RES     = RESET ;

/* Host data buffers; HDIR = 1 is S-100 -> HD (writes)
 *   U38 DO <-> HD0-7 : all writes except +3, and the low byte of a
 *                      16-bit read
 *   U40 HD0-7 -> DI  : 8-bit reads of +0, +2 and +4..+7
 *                      (+1 MODE is write-only, +3 is 16-bit only)
 *   U39 DI <-> HD8-15: 16-bit transfers only (high byte) */
HDIR    = sOUT ;
DLDEN   = WRSEL & !(!SA2 & SA1 & SA0)
        # RDEN & X16 ;
DH2LEN  = RDEN & !X16 & (SA2 # !SA0) ;
DHDEN   = WRSEL & X16
        # RDEN & X16 ;

/* MODE register write at +1: U41 '273 latches on the rising edge */
CTRL_WR = IODEC & sOUT & pWR & !SA2 & !SA1 & SA0 ;
