Name     U45 ;
PartNo   00 ;
Date     10/01/26 ;
Revision 02 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board ;
Location U45 ;
Device   G16V8MA ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/*************************************************************************
 * U45 - GAL16V8, sheet "S100 Interface"
 *
 * S-100 bus decode for the ACRTC (U1 HD63484) and Bt453 RAMDAC (U47)
 * register ports, plus the RDY wait-state and ~SIXTN 16-bit acknowledge
 * bus responses.
 *
 * Complex mode (G16V8MA): RDY and ~SIXTN are open-collector S-100 bus
 * lines, so those outputs must only be driven while asserted, using .OE
 * product terms (emulated open collector). Each output enable is a single
 * product term. Pins 1 and 11 are ordinary inputs; pins 12 and 19 have no
 * feedback.
 *
 * Speed grade: GAL16V8-15 (15 ns) or faster. A slower part would not lengthen the
 * guaranteed R/W-before-CS lead: it is set by the minimum tpd, which is
 * 3 ns for both the -15 and the -25.
 *
 * ~DTACK (pin 11) is pulled up by R1 (10K).
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 10/01/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = SA2       ; /* S-100 A2 (P1 pin 81)                                    */
PIN 2  = SA1       ; /* S-100 A1 (P1 pin 80)                                    */
PIN 3  = SA0       ; /* S-100 A0 (P1 pin 79)                                    */
PIN 4  = !pWR      ; /* net p~{WR} - S-100 p~WR (P1 pin 77)                     */
PIN 5  = pDBIN     ; /* S-100 pDBIN (P1 pin 78)                                 */
PIN 6  = sOUT      ; /* S-100 sOUT (P1 pin 45)                                  */
PIN 7  = sINP      ; /* S-100 sINP (P1 pin 46)                                  */
PIN 8  = !SXTRQ    ; /* net ~{SXTRQ} - S-100 ~SXTRQ (P1 pin 58)                 */
PIN 9  = IODEC     ; /* board I/O address match from U60 pin 18                 */
PIN 11 = !DTACK    ; /* net ~{DTACK} - ACRTC ~DTACK (U1 pin 10), R1 pull-up     */

/* ---- Outputs ---- */
PIN 12 = CRT_RS    ; /* ACRTC RS (U1 pin 5)                                     */
PIN 13 = !CRT_CS   ; /* net ~{CRT_CS} - ACRTC ~CS (U1 pin 4)                    */
PIN 14 = CRT_RW    ; /* net CRT_R/~{W} - ACRTC R/~W (U1 pin 3); 1 = read        */
PIN 15 = RDY       ; /* S-100 RDY (P1 pin 72)                                   */
PIN 16 = !SIXTN    ; /* net ~{SIXTN} - S-100 ~SIXTN (P1 pin 60)                 */
PIN 17 = !DAC_WR   ; /* net ~{DAC_WR} - Bt453 ~WR (U47 pin 28)                  */
PIN 18 = !DAC_RD   ; /* net ~{DAC_RD} - Bt453 ~RD (U47 pin 27)                  */
PIN 19 = !DAC_CS   ; /* net ~{DAC_CS} - Bt453 ~CS (U47 pin 26)                  */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

/* Board I/O cycle (IODEC = address match from U60) */
IOSEL   = IODEC & (sINP # sOUT) ;
CRTSEL  = IOSEL & !SA2 & !SA0 ;            /* ACRTC: +0 (RS=0), +2 (RS=1) */
DACSEL  = IOSEL & SA2 ;                    /* Bt453: +4..+7, C1C0 = SA1..0 */

/* ACRTC. CS, R/W and RS are sampled on 2CLK edges, and R/W and RS need
 * 10-20 ns more setup than CS.
 *   - R/W = !sOUT rests at 1 (read) between cycles, so it is already
 *     settled when a read CS falls.
 *   - A write CS also waits for the R/W pin (pin 14 feedback) to go low,
 *     so R/W always changes first.
 *   - CS comes from status, not pDBIN/pWR. RDY must be low by T2, and an
 *     8080 asserts pWR only after its wait states. */
CRT_RW    = !sOUT ;
CRT_CS    = CRTSEL & sINP
          # CRTSEL & sOUT & !CRT_RW ;
CRT_RS    = SA1 ;
CRT_CS.OE = 'b'1 ;
CRT_RS.OE = 'b'1 ;
CRT_RW.OE = 'b'1 ;

/* Open-collector outputs. A complex-mode output enable is a single product
 * term, so both use the CRT_CS pin (pin 13 feedback), which already holds
 * the board, I/O-cycle and ACRTC-port decode.
 *   RDY:   pull low (wait) until the ACRTC answers with ~DTACK. CS and
 *          ~DTACK both last to the end of the cycle.
 *   SIXTN: 16-bit transfers only to the ACRTC data register at +2. */
RDY       = 'b'0 ;
RDY.OE    = CRT_CS & !DTACK ;
SIXTN     = 'b'1 ;
SIXTN.OE  = CRT_CS & SXTRQ & SA1 ;

/* Bt453: CS for the whole cycle (35 ns setup/hold around RD/WR) */
DAC_CS    = DACSEL ;
DAC_RD    = DACSEL & sINP & pDBIN ;
DAC_WR    = DACSEL & sOUT & pWR ;
DAC_CS.OE = 'b'1 ;
DAC_RD.OE = 'b'1 ;
DAC_WR.OE = 'b'1 ;
