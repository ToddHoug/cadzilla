Name     U60 ;
PartNo   00 ;
Date     10/01/26 ;
Revision 02 ;
Designer Todd Houg ;
Company  CADzilla ;
Assembly CADzilla S-100 ACRTC board ;
Location U60 ;
Device   G16V8MA ;

/* SPDX-License-Identifier: CERN-OHL-P-2.0 */
/* Copyright (C) 2026 Todd Houg */

/*************************************************************************
 * U60 - GAL16V8, sheet "S100 Interface"
 *
 * Board I/O address decode (A8-A15, 16-bit I/O enable, 74LS85 compare)
 * and HSYNC/VSYNC output polarity select for the VGA connector.
 *
 * Complex mode (G16V8MA): pins 14-17 are used as inputs. Simple mode
 * cannot use pins 15/16 as inputs. Pins 12 and 19 are output-only.
 *
 * Speed grade: GAL16V8-15 (15 ns) or faster.
 *
 * ~HSYNC (pin 17) and ~VSYNC (pin 16) come from the ACRTC; HSPOL and
 * VSPOL come from the U41 control latch. Pin 19 is unconnected.
 *
 * Polarity: pins declared with '!' are active-low; write their equations
 * in active-true terms (e.g. X = ... asserts the pin LOW).
 * Pin/net assignments taken from the KiCad schematic, 10/01/26.
 *************************************************************************/

/* ---- Inputs ---- */
PIN 1  = SA8       ; /* S-100 A8 (P1 pin 84)                                    */
PIN 2  = SA9       ; /* S-100 A9 (P1 pin 34)                                    */
PIN 3  = SA10      ; /* S-100 A10 (P1 pin 37)                                   */
PIN 4  = SA11      ; /* S-100 A11 (P1 pin 87)                                   */
PIN 5  = SA12      ; /* S-100 A12 (P1 pin 33)                                   */
PIN 6  = SA13      ; /* S-100 A13 (P1 pin 85)                                   */
PIN 7  = SA14      ; /* S-100 A14 (P1 pin 86)                                   */
PIN 8  = SA15      ; /* S-100 A15 (P1 pin 32)                                   */
PIN 9  = !EN16     ; /* net ~{EN16} - SW1 / RN1 pull-up: 16-bit I/O addressing  */
PIN 11 = IODEC8    ; /* U44 74LS85 A=B (pin 6): low address byte match          */
PIN 14 = HSPOL     ; /* U41 74LS273 Q0 (pin 2)                                  */
PIN 15 = VSPOL     ; /* U41 74LS273 Q1 (pin 5)                                  */
PIN 16 = !VSYNC_IN ; /* net ~{VSYNC} - ACRTC ~VSYNC (U1 pin 13)                 */
PIN 17 = !HSYNC_IN ; /* net ~{HSYNC} - ACRTC ~HSYNC (U1 pin 12)                 */

/* ---- Outputs ---- */
PIN 12 = VSYNC     ; /* J1 DE15 pin 14 / J2 pin 14                              */
PIN 13 = HSYNC     ; /* J1 DE15 pin 13 / J2 pin 13                              */
PIN 18 = IODEC     ; /* U45/U46 pin 9                                           */
/* PIN 19 = unconnected */
/* PIN 10 = GND, PIN 20 = +5V */

/* ---- Equations ---- */

/* Board I/O address match. IODEC8 = A3-A7 match SW1-1..5 (U44/U43).
 * With ~EN16 asserted (SW1-7 on), A8-A15 must also be 00h. */
IODEC    = IODEC8 & !EN16
         # IODEC8 & !SA8 & !SA9 & !SA10 & !SA11 & !SA12 & !SA13 & !SA14 & !SA15 ;

/* VGA sync polarity: xSPOL = 1 gives a negative (active-low) pulse,
 * 0 a positive one. xSYNC_IN is true while the ACRTC sync is active. */
HSYNC    = HSYNC_IN $ HSPOL ;
VSYNC    = VSYNC_IN $ VSPOL ;

IODEC.OE = 'b'1 ;
HSYNC.OE = 'b'1 ;
VSYNC.OE = 'b'1 ;
