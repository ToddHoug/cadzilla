# KiCAD
schematics/*.bak
schematics/*-backups/
schematics/_autosave-*
schematics/fp-info-cache
schematics/*.kicad_prl

# Build outputs
software/*/build/*
!software/*/build/.gitkeep
# L80 symbol files (/Y), written into src/ for the debugger's SYMBOLS LOAD
software/*/src/*.SYM

# altairsim working disks -- pristine/ is the tracked master; each project has its own
# work/ (mutated in place, never shared between projects)
software/*/work/

# the czgfx library disk -- a build product of software/czgfx/src, rebuilt from it
software/*/libdisk/

# altairsim's own command-history file -- can leak into pristine/ if it's ever booted
# directly (which it never should be); ignored everywhere as a safety net
.altairsim_history

# OS
.DS_Store

# personal prompt notes (local only)
MyPrompts.md
