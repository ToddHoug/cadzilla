;
; CZPTEST.Z88 -- cz88gfx 1.3 on the real HD63484: PAINT's seeds and
; ELPS's parameter limit (8080 code)
;
; altairsim models neither limit, so there this only shows the code paths
; run and draw correctly; the real board is the test. Each step is named
; on the console before it starts, so a hang shows where it stopped.
;
;   PAINT  a comb of 20 pockets off one strip, painted from the strip
;          (GPAINT) then recolored (GFLOOD). A fill like this needs more
;          seeds than the chip's four, so on the board it only finishes if
;          the library reads the overflow back. Each pocket is read back.
;          "PAINT . nn": '.' NC, 'C' seeds dropped; nn pockets missed.
;   ELPS   ellipses whose a, b and dX break ELPS-3 (la+ldX, lb+ldX <= 13)
;          -- cgfxdemo's 240x20 hung board B -- and ones that keep to it.
;          Each is drawn alone, waited for, and its four extreme points
;          read back (within a pixel). "ELPS . nn": '.' no command error,
;          nn points missed.
;   EARC   a small elliptical arc (drawn: '.') and one whose X semi-axis
;          is 9000 (refused: 'C').
;
        INCLUDE "CZ88GFX.INC"
;
BDOS    EQU     0005H
CONOUT  EQU     2
PSTRING EQU     9
CR      EQU     0DH
LF      EQU     0AH
;
WALL    EQU     WHITE+BRIGHT
FILL1   EQU     RED+BRIGHT
FILL2   EQU     BLUE+BRIGHT
INK     EQU     GREEN+BRIGHT
;
        ORG     0100H
;
START:  LXI     D,MHELLO
        CALL    PRINT
        GINIT   CZM1K
;
; ---- PAINT: the comb ----
;
        LXI     D,MCOMB
        CALL    PRINT
        GCOLOR  WALL
        GBOX    100,100,920,400
        LXI     H,141           ;19 inner walls, 41 apart, from y=160 up
WALLS:  PUSH    H
        LXI     D,160
        CALL    CZMOVE
        LXI     D,401           ;(the end point isn't drawn)
        CALL    CZLINE
        POP     H
        LXI     D,41
        DAD     D
        MOV     A,L             ;up to 100+19*41 = 879
        CPI     0+(100+20*41) % 256
        JNZ     WALLS
;
        LXI     D,MPAINT
        CALL    PRINT
        GCOLOR  FILL1
        GBCOL   FILL1           ;CL0 is an edge too: not the black
        GPAINT  110,130,WALL
        CALL    FLAG
        MVI     A,FILL1
        CALL    POCKETS
        LXI     D,MFLOOD
        CALL    PRINT
        GCOLOR  FILL2
        GBCOL   FILL2
        GFLOOD  110,130,FILL1
        CALL    FLAG
        MVI     A,FILL2
        CALL    POCKETS
        LXI     D,MNL
        CALL    PRINT
        GBCOL   0
;
; ---- ELPS ----
;
        LXI     D,MELPS
        CALL    PRINT
        XRA     A
        STA     MISS
        STA     CERR
        LXI     H,ELTAB
ELLP:   MOV     A,M             ;rx = 0 ends the table
        INX     H
        ORA     M
        DCX     H
        JZ      ELEND
        PUSH    H
        GCLS    0
        GCOLOR  INK
        GMOVE   512,384
        POP     H
        PUSH    H
        CALL    CZLDW           ;DE = rx
        PUSH    D
        CALL    CZLDW           ;DE = ry
        SHLD    TP
        POP     H               ;HL = rx
        SHLD    ERX
        XCHG
        SHLD    ERY
        XCHG
        CALL    CZELPS
        GWAIT
        JZ      EL1
        LXI     H,CERR
        INR     M
        GABORT
EL1:    LHLD    ERX             ;(512+-rx, 384) and (512, 384+-ry)
        LXI     D,512
        DAD     D
        LXI     D,384
        MVI     A,1
        CALL    NEAR
        LHLD    ERX
        CALL    NEGHL
        LXI     D,512
        DAD     D
        LXI     D,384
        MVI     A,1
        CALL    NEAR
        LHLD    ERY
        LXI     D,384
        DAD     D
        XCHG
        LXI     H,512
        XRA     A
        CALL    NEAR
        LHLD    ERY
        CALL    NEGHL
        LXI     D,384
        DAD     D
        XCHG
        LXI     H,512
        XRA     A
        CALL    NEAR
        LHLD    TP
        POP     D
        JMP     ELLP
ELEND:  LDA     CERR
        ORA     A
        MVI     A,'.'
        JZ      EL2
        MVI     A,'E'
EL2:    CALL    PCHR
        MVI     A,' '
        CALL    PCHR
        LDA     MISS
        CALL    P2
        LXI     D,MNL
        CALL    PRINT
;
; ---- EARC ----
;
        LXI     D,MEARC
        CALL    PRINT
        GCLS    0
        GCOLOR  INK
        GMOVE   747,200
        GEARC   4,3,733,200,705,200,DIRCCW      ;a small one: drawn
        CALL    FLAG
        MVI     A,' '
        CALL    PCHR
        GMOVE   512,384
        GEARC   90,1,512,284,612,284,DIRCCW     ;dX 9000: refused
        CALL    FLAG
        GWAIT
        LXI     D,MDONE
        CALL    PRINT
        RET
;
; FLAG -- print '.' for NC, 'C' for CY
;
FLAG:   MVI     A,'.'
        JNC     PCHR
        MVI     A,'C'
        JMP     PCHR
;
; POCKETS -- read back the middle of each of the 20 pockets, (120+41k,
; 300); print " nn", the ones not in color A
;
POCKETS: STA    WANT
        XRA     A
        STA     MISS
        LXI     H,120
POLP:   PUSH    H
        LXI     D,300
        CALL    CZRDOT
        LXI     H,WANT
        CMP     M
        JZ      PO1
        LXI     H,MISS
        INR     M
PO1:    POP     H
        LXI     D,41
        DAD     D
        MOV     A,L
        CPI     0+(120+20*41) % 256
        JNZ     POLP
        MVI     A,' '
        CALL    PCHR
        LDA     MISS
        CALL    P2
        MVI     A,' '
        JMP     PCHR
;
; NEAR -- is HL,DE (or a pixel next to it: along X if A = 1, else along
; Y) in INK? If not, count a miss
;
NEAR:   STA     NAX
        MVI     C,3
        PUSH    H
        PUSH    D
        LDA     NAX             ;start one before
        ORA     A
        JZ      NY0
        DCX     H
        JMP     NLP
NY0:    DCX     D
NLP:    CALL    CZRDOT
        CPI     INK
        JZ      NHIT
        LDA     NAX
        ORA     A
        JZ      NY1
        INX     H
        JMP     NNX
NY1:    INX     D
NNX:    DCR     C
        JNZ     NLP
        LXI     H,MISS
        INR     M
NHIT:   POP     D
        POP     H
        RET
;
NEGHL:  MOV     A,H
        CMA
        MOV     H,A
        MOV     A,L
        CMA
        MOV     L,A
        INX     H
        RET
;
; console
;
PRINT:  MVI     C,PSTRING
        JMP     BDOS
PCHR:   PUSH    B
        PUSH    D
        PUSH    H
        PUSH    PSW
        MOV     E,A
        MVI     C,CONOUT
        CALL    BDOS
        POP     PSW
        POP     H
        POP     D
        POP     B
        RET
P2:     MVI     B,'0'-1         ;A as two decimal digits
P2L:    INR     B
        SUI     10
        JNC     P2L
        ADI     10+'0'
        PUSH    PSW
        MOV     A,B
        CALL    PCHR
        POP     PSW
        JMP     PCHR
;
; The ellipses, rx, ry: the first five break ELPS-3 as plain ELPS would
; send them (cgfxdemo's 240x20 hung board B); the last three keep to it
;
ELTAB:  DW      240,20, 480,300, 20,240, 511,383, 100,60
        DW      100,100, 8,6, 30,30
        DW      0,0
;
MHELLO: DB      "CZPTEST -- cz88gfx PAINT seeds and ELPS limits",CR,LF,'$'
MCOMB:  DB      "comb... ",'$'
MPAINT: DB      "PAINT ",'$'
MFLOOD: DB      "FLOOD ",'$'
MELPS:  DB      "ELPS ",'$'
MEARC:  DB      "EARC ",'$'
MDONE:  DB      CR,LF,"done",CR,LF,'$'
MNL:    DB      CR,LF,'$'
;
WANT:   DS      1
MISS:   DS      1
CERR:   DS      1
NAX:    DS      1
TP:     DS      2
ERX:    DS      2
ERY:    DS      2
