;
; CZCHK.MAC -- czgfx library build check
;
; Not a demo: CZBUILD.SUB assembles this against the library as
; published on B: (B:CZGFX.INC) and links it with B:CZLINK.SUB, so a
; broken macro, a missing PUBLIC or a wrong link order fails the
; library build instead of the first consumer project. It expands every
; macro and references every entry point (as NAME##, the way a program
; outside the macros must); running it does nothing.
;
        INCLUDE B:CZGFX.INC
;
        CSEG
;
START:  RET                     ;nothing below is ever executed
;
        GINIT
        GINIT   CZM800
        GINIT   CZM1K
        GCLS
        GCLS    BLUE+4
        GCOLOR  WHITE+BRIGHT
        GCOLOR
        GPAL    1,255,128,0
        GMOVE   10,20
        GMOVE   ,20
        GMOVE   10
        GLINE   30,40
        GRECT   50,60
        GFRECT  70,80
        GDOT    90,100
        GRMOVE  -5,5
        GRLINE  5,-5
        GRRECT  10,10
        GRFRCT  -10,-10
        GSEG    0,0,639,479
        GBOX    1,1,638,478
        GFBOX   2,2,20,20
        GFBOX   2,2,20,20,RED+BRIGHT
        GPLINE  <0,0,10,10,20,0>
        GPOLY   <100,100,150,100,125,140>
        GPLT    PTS1
        GPLG    PTS1
        GPLT
        GWAIT
        GABORT
;
        LHLD    CZXMAX##
        LHLD    CZYMAX##
        LXI     H,CZPALD##
        LXI     H,CZWREG##
        LXI     H,CZPUTW##
        LXI     H,CZXY##
        LXI     H,CZSEND##
        LXI     H,CZRTAB##
        LXI     H,CZLDW##
        RET
;
        GPTS    PTS1,<5,5,50,5,50,50>
;
        END     START
