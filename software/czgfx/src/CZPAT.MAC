;
; CZPAT.MAC -- czgfx: the pattern RAM
;
; Loading the ACRTC's 16-word pattern RAM (WPTN), a one-row line style,
; and PTN, which draws the pattern RAM itself as a small picture. The
; scan window and pointer (PRC, Pr05-07) are set with CZWPR -- the
; GPSCAN and GPPTR macros. See CZGFX.INC for the pattern layout.
;
        INCLUDE CZGFX.INC
;
        PUBLIC  CZLPAT,CZLSTY,CZPTN
        EXTRN   CZPUTW,CZSEND,CZLDW,CZWPR,CZCMD
;
        CSEG
;
; CZLPAT -- load the pattern RAM from word A (0-15) with the table at
; HL: DW n (1-16), then n words, as GPAT and GTILE build it. Returns
; HL just past the table.
;
CZLPAT: PUSH    B
        PUSH    D
        PUSH    H
        ANI     0FH             ;WPTN, PRA = A
        MOV     L,A
        MVI     H,18H
        CALL    CZPUTW
        POP     H
        CALL    CZLDW           ;DE = n
        XCHG
        PUSH    H
        DAD     H               ;in 8-bit bus mode WPTN counts bytes
        CALL    CZPUTW
        POP     B               ;BC = n words
        XCHG
        CALL    CZSEND
        POP     D
        POP     B
        RET
;
; CZLSTY -- line style: pattern row 0 = HL (bit 0 first), scan window
; columns 0-15 of row 0 only, each bit drawn A+1 times (A = 0-15),
; pointer at the start
;
CZLSTY: PUSH    B
        PUSH    H
        ANI     0FH             ;C = Pr07 low: PEX=15, PZX=A
        ORI     0F0H
        MOV     C,A
        LXI     H,1800H         ;WPTN PRA=0, 2 bytes: row 0
        CALL    CZPUTW
        LXI     H,2
        CALL    CZPUTW
        POP     H
        PUSH    H
        CALL    CZPUTW
        MOV     L,C             ;Pr07: PEY=0, PZY=0 -- one row
        MVI     H,0
        MVI     A,07H
        CALL    CZWPR
        LXI     H,0             ;Pr06: PSY=PSX=0
        MVI     A,06H
        CALL    CZWPR
        MVI     A,05H           ;Pr05: pointer 0,0, zoom counters 0
        CALL    CZWPR
        POP     H
        POP     B
        RET
;
; CZPTN -- draw the pattern RAM as a picture at CP: HL = size, H =
; height-1, L = width-1 (SZ); A = direction (0-7, +PTSLNT)
;
CZPTN:  ANI     0FH
        ORI     OPPTN
        CALL    CZCMD
        JMP     CZPUTW
;
        END
