;
; CZPAL.MAC -- czgfx: Bt453 color palette
;
; The default palette is 8 hues x 32 brightness levels:
; index = hue*32 + level, hues ORANGE BLUE GREEN CYAN RED MAGENTA
; YELLOW WHITE (CZGFX.INC), level 0 = black .. 31 = BRIGHT.
;
CZLIB   EQU     1
        INCLUDE CZGFX.INC
;
        PUBLIC  CZPALD,CZPALS
;
        CSEG
;
; CZPALD -- load all 256 Bt453 palette entries with the default
; palette. Clobbers BC, DE, HL.
;
CZPALD: XRA     A               ;address 0, resets color phase to red
        OUT     DACADR
        LXI     H,HUETAB
        MVI     C,8             ;hues
PALH:   LXI     D,LEVTAB
        MVI     B,32            ;levels per hue
PALL:   LDAX    D
        STA     LEVEL
        PUSH    H
        CALL    CHAN            ;red
        CALL    CHAN            ;green
        CALL    CHAN            ;blue
        POP     H
        INX     D
        DCR     B
        JNZ     PALL
        INX     H               ;next hue
        INX     H
        INX     H
        DCR     C
        JNZ     PALH
        RET
;
; CHAN -- write one color component. (HL) = channel code
; (0 off, 1 full, 2 half), LEVEL = intensity. HL += 1.
;
CHAN:   MOV     A,M
        INX     H
        ORA     A
        JZ      CHOUT           ;off: A = 0
        CPI     2
        LDA     LEVEL
        JNZ     CHOUT           ;full
        ORA     A               ;half: clear carry, shift right
        RAR
CHOUT:  OUT     DACPAL
        RET
;
; CZPALS -- set palette entry A to red B, green C, blue E
;
CZPALS: OUT     DACADR          ;address, resets color phase to red
        MOV     A,B
        OUT     DACPAL
        MOV     A,C
        OUT     DACPAL
        MOV     A,E
        OUT     DACPAL
        RET
;
; Channel codes R,G,B for each hue (index order)
;
HUETAB: DB      1,2,0           ;0 orange
        DB      0,0,1           ;1 blue
        DB      0,1,0           ;2 green
        DB      0,1,1           ;3 cyan
        DB      1,0,0           ;4 red
        DB      1,0,1           ;5 magenta
        DB      1,1,0           ;6 yellow
        DB      1,1,1           ;7 white
;
; Linear brightness ramp: level*255/31
;
LEVTAB: DB      0,8,16,25,33,41,49,58
        DB      66,74,82,90,99,107,115,123
        DB      132,140,148,156,165,173,181,189
        DB      197,206,214,222,230,239,247,255
;
LEVEL:  DS      1
;
        END
