;
; GFXDEMO.MAC -- CADzilla czgfx graphics library demo
;
; The first program built with the M80/L80 toolchain and the shared
; czgfx library (software/czgfx). Everything board-specific -- the ACRTC
; registers, the Bt453 palette, the FIFO protocol -- comes from the
; library; this file is only the pictures. Three screens, each described
; on the console; press any key for the next one, ESC (or ^C) to quit.
;
;   1  Palette & fills   all 256 palette entries as filled boxes, hues
;                        top to bottom, black to full brightness left
;                        to right, inside a white frame (GFBOX, GBOX)
;   2  Lines             a 36-spoke starburst from a data table (GMOVE,
;                        GLINE) and 10 nested rectangles unrolled at
;                        assembly time by REPT (GBOX)
;   3  Polys & dots      a 5-point star and a hexagon (GPOLY), a triangle
;                        from a named table (GPTS, GPLG), a sine wave
;                        (GPLT) and 400 random dots (GDOT)
;
; Build (czgfx library disk mounted as B:, see cadzilla-build-m80):
;   A0>M80 GFXDEMO,GFXDEMO=GFXDEMO
;   A0>SUBMIT B:CZLINK GFXDEMO
;
        INCLUDE B:CZGFX.INC
;
BDOS    EQU     0005H
CONIN   EQU     1               ;console input (waits, echoes)
PSTRING EQU     9
CR      EQU     0DH
LF      EQU     0AH
ESC     EQU     1BH
CTLC    EQU     03H
;
        CSEG
;
START:  LXI     H,0             ;keep CCP's stack, run on our own
        DAD     SP
        SHLD    OLDSP
        LXI     SP,STACK
;
        LXI     D,MSGHI
        CALL    PRINT
        GINIT   CZM1K           ;1024x768, default palette, screen cleared
;
        LXI     D,MSG1
        CALL    PRINT
        CALL    SCR1
        CALL    DONE
        JZ      EXIT
;
        LXI     D,MSG2
        CALL    PRINT
        CALL    SCR2
        CALL    DONE
        JZ      EXIT
;
        LXI     D,MSG3
        CALL    PRINT
        CALL    SCR3
        CALL    DONE
;
EXIT:   LXI     D,MSGBYE
        CALL    PRINT
        LHLD    OLDSP
        SPHL
        RET
;
;
; ================= console =================
;
PRINT:  MVI     C,PSTRING
        JMP     BDOS
;
; DONE -- wait for the screen to finish drawing, report a command
; error if there was one, then wait for a key. Returns Z if the key
; was ESC or ^C (quit).
;
; The key is read with BDOS function 1, not 6 (direct I/O): while
; function 9 prints, the BDOS polls the keyboard for ^S and keeps any
; other key it finds in its own buffer, which function 1 reads and
; function 6 bypasses -- so a key pressed during the prompt would be
; lost, and turn up later at the CCP prompt instead.
;
DONE:   GWAIT
        JZ      DNOK
        LXI     D,MSGER         ;command error: say so, clear it
        CALL    PRINT
        GABORT
        JMP     DNKEY
DNOK:   LXI     D,MSGOK
        CALL    PRINT
DNKEY:  LXI     D,MSGKEY
        CALL    PRINT
        MVI     C,CONIN
        CALL    BDOS
        PUSH    PSW
        LXI     D,MSGNL
        CALL    PRINT
        POP     PSW
        CPI     ESC
        RZ
        CPI     CTLC
        RET
;
;
; ================= screen 1: palette & fills =================
;
; 32 columns (levels) x 8 rows (hues), 28x80 pixel cells on a 32x90
; pitch, hue 0 on top. The loop keeps X in GX, Y in GY and the palette
; index in COLIX, and hands the macros blank arguments ("already in
; HL/DE") for the computed corners.
;
SCR1:   GCLS
        XRA     A
        STA     COLIX
        LXI     H,38+7*90       ;bottom Y of the top row
        SHLD    GY
S1ROW:  LXI     H,2             ;left X of the first column
        SHLD    GX
S1CELL: LDA     COLIX
        GCOLOR
        LHLD    GY
        XCHG                    ;DE = Y
        LHLD    GX              ;HL = X
        GMOVE
        LXI     B,27            ;far corner: X+27, Y+79
        DAD     B
        XCHG
        LXI     B,79
        DAD     B
        XCHG
        GFRECT
        LHLD    GX              ;next column
        LXI     B,32
        DAD     B
        SHLD    GX
        LDA     COLIX
        INR     A
        STA     COLIX
        ANI     31
        JNZ     S1CELL
        LHLD    GY              ;next row down
        LXI     B,-90
        DAD     B
        SHLD    GY
        LDA     COLIX           ;wraps to 0 after all 256
        ORA     A
        JNZ     S1ROW
;
        GCOLOR  WHITE+BRIGHT
        GBOX    0,0,1023,767
        RET
;
;
; ================= screen 2: lines =================
;
SCR2:   GCLS
;
; Starburst: 36 spokes from the centre (272,384), radius 240, one
; color per spoke cycling through the 8 hues.
;
        LXI     H,SPOKES
        MVI     B,36
        MVI     C,0             ;hue 0..7
S2SPK:  MOV     A,C             ;color = hue*32 + BRIGHT
        RRC
        RRC
        RRC
        ORI     BRIGHT
        GCOLOR
        PUSH    H
        GMOVE   272,384
        POP     H
        CALL    CZLDW##         ;DE = end X (library routine, direct)
        PUSH    D
        CALL    CZLDW##         ;DE = end Y
        XTHL                    ;HL = end X, table pointer on stack
        GLINE
        POP     H
        INR     C
        MOV     A,C
        ANI     7
        MOV     C,A
        DCR     B
        JNZ     S2SPK
;
; Nested rectangles: REPT unrolls one GBOX per level at assembly time,
; the corners and color computed from the counter N.
;
N       SET     0
        REPT    10
        GCOLOR  <(N MOD 8)*32+BRIGHT-(N/8)*12>
        GBOX    560+N*19,160+N*19,992-N*19,608-N*19
N       SET     N+1
        ENDM
;
        GCOLOR  WHITE+BRIGHT    ;an X corner to corner of the innermost
        GSEG    731,331,821,437
        GSEG    731,437,821,331
        RET
;
;
; ================= screen 3: polygons, polylines, dots =================
;
SCR3:   GCLS
;
        GCOLOR  YELLOW+BRIGHT   ;5-point star, the points given inline
        GPOLY   <240,704,202,595,88,594,179,525,146,414,240,480,334,414,301,525,392,594,278,595>
;
        GCOLOR  CYAN+BRIGHT     ;hexagon
        GPOLY   <928,544,856,669,712,669,640,544,712,419,856,419>
;
        GCOLOR  MAGENTA+BRIGHT  ;triangle from a named table
        GPLG    TRI
;
        GCOLOR  GREEN+BRIGHT    ;sine wave, 33 points
        GPLT    SINE
;
        GCOLOR  WHITE+16        ;axis under the wave
        GSEG    64,152,987,152
;
; 400 dots in the band between the shapes and the wave, at random
; positions (xorshift), colors cycling through the palette.
;
        LXI     B,400
S3DOT:  CALL    RAND            ;X = 102 + a + a/2, a = R AND 511
        MOV     A,H
        ANI     1               ;(ANI also clears CY for the RARs)
        MOV     H,A
        MOV     D,A             ;DE = a/2
        MOV     E,L
        MOV     A,D
        RAR
        MOV     D,A
        MOV     A,E
        RAR
        MOV     E,A
        DAD     D
        LXI     D,102
        DAD     D
        PUSH    H
        CALL    RAND            ;Y = 282 + b + b/2, b = R AND 63
        MOV     A,L
        ANI     63
        MOV     E,A
        RAR
        ADD     E
        MOV     E,A
        MVI     D,0
        PUSH    H
        LXI     H,282
        DAD     D
        XCHG                    ;DE = Y
        POP     H
        MOV     A,H             ;color from the high byte
        ORI     16              ;never too dark
        GCOLOR
        POP     H
        GDOT
        DCX     B
        MOV     A,B
        ORA     C
        JNZ     S3DOT
        RET
;
; RAND -- 16-bit xorshift (7,9,8): SEED = next value, returned in HL.
; Preserves BC, DE.
;
RAND:   LHLD    SEED
        MOV     A,H             ;x ^= x << 7
        RAR
        MOV     A,L
        RAR
        XRA     H
        MOV     H,A
        MOV     A,L
        RAR
        MOV     A,H
        RAR
        XRA     L
        MOV     L,A             ;x ^= x >> 9
        XRA     H               ;x ^= x << 8
        MOV     H,A
        SHLD    SEED
        RET
;
;
; ================= data =================
;
; Starburst end points: 36 X,Y pairs on a circle of radius 240
;
SPOKES: DW      512,384,508,426,498,466,480,504
        DW      456,538,426,568,392,592,354,610
        DW      314,620,272,624,230,620,190,610
        DW      152,592,118,568,88,538,64,504
        DW      46,466,36,426,32,384,36,342
        DW      46,302,64,264,88,230,118,200
        DW      152,176,190,158,230,148,272,144
        DW      314,148,354,158,392,176,426,200
        DW      456,230,480,264,498,302,508,342
;
        GPTS    TRI,<480,448,576,704,400,640>
;
; Sine wave: a point table written out by hand -- the same layout
; GPTS builds (DW count, then X,Y pairs), for lists too long for one
; macro line
;
SINE:   DW      33
        DW      64,152,93,186,122,214,150,233
        DW      179,240,208,233,237,214,266,186
        DW      294,152,323,118,352,90,381,71
        DW      410,64,438,71,467,90,496,118
        DW      525,152,554,186,582,214,611,233
        DW      640,240,669,233,698,214,726,186
        DW      755,152,784,118,813,90,842,71
        DW      870,64,899,71,928,90,957,118
        DW      986,152
;
MSGHI:  DB      'GFXDEMO -- CADzilla czgfx library demo (M80/L80)',CR,LF,'$'
MSG1:   DB      'Screen 1: palette & fills -- 256 GFBOX cells, GBOX frame',CR,LF,'$'
MSG2:   DB      'Screen 2: lines -- GLINE starburst, REPT-unrolled GBOX nest',CR,LF,'$'
MSG3:   DB      'Screen 3: GPOLY star + hexagon, GPLG triangle, GPLT sine, GDOT',CR,LF,'$'
MSGOK:  DB      '  drawn OK',CR,LF,'$'
MSGER:  DB      '  ACRTC COMMAND ERROR (CER) -- aborted',CR,LF,'$'
MSGKEY: DB      '  press a key (ESC quits)...$'
MSGNL:  DB      CR,LF,'$'
MSGBYE: DB      'GFXDEMO done.',CR,LF,'$'
;
SEED:   DW      0ACE1H
GX:     DS      2
GY:     DS      2
COLIX:  DS      1
OLDSP:  DS      2
        DS      64
STACK:
;
        END     START
