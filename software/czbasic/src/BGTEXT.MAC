;
; BGTEXT.MAC -- CZBASIC: CZTEXT x,y,s$[,c[,scale[,dir]]]
;
; Text on the graphics screen in czgfx's 8x8 font (CZF8, 5x7 glyphs):
; the arguments are parsed here and czgfx's text routines (CZTXT.MAC)
; draw it, each character with PTN, in the color mode CMCL1 (the
; character's 0 bits leave the screen alone) and the pattern zoom making
; it scale times bigger (1-16). dir turns the text in 45-degree steps
; counter-clockwise (0-7), as PTN does; the pen moves on 8*scale pixels
; that way after each character. x,y is the bottom-left corner of the
; first character. Afterwards the pattern RAM is all ones again with the
; whole 16x16 scan window, as CZINIT left it.
;
        INCLUDE BASIC.INC
        INCLUDE B:CZGFX.INC
;
        PUBLIC  XTEXT
;
        EXTRN   GETINT,FRMSTR,FRESTR,GARG,GNUM,GTXT,GPARSE,GWCOL,GRCOL
        EXTRN   FCERR
;
        CSEG
;
XTEXT:  CALL    GETINT          ;x, y
        XCHG
        SHLD    CZTST##         ;the pen, straight into czgfx's text state
        XCHG
        SYNCHK  ','
        CALL    GETINT
        XCHG
        SHLD    CZTST##+2
        XCHG
        SYNCHK  ','
        CALL    FRMSTR          ;s$: its length and text
        PUSH    H
        CALL    FRESTR
        MOV     A,B
        STA     TLEN
        XCHG
        SHLD    TPTR
        POP     H
        XRA     A               ;[,c[,scale[,dir]]]
        STA     GNUM
        SHLD    GTXT
        MOV     A,M
        CPI     ','
        JNZ     TX1
        CHRGET
        LXI     B,0103H
        CALL    GPARSE
TX1:    MVI     A,1             ;scale 1..16
        STA     CZTST##+8       ;the scale
        LDA     GNUM
        CPI     2
        JC      TX2
        LDA     GARG+2
        ORA     A
        JZ      FCERR
        CPI     17
        JNC     FCERR
        STA     CZTST##+8       ;the scale
TX2:    XRA     A               ;direction
        STA     CZTST##+9       ;the direction
        LDA     GNUM
        CPI     3
        JC      TX3
        LDA     GARG+4
        ANI     7
        STA     CZTST##+9       ;the direction
TX3:    LDA     TLEN
        ORA     A
        JZ      TXEND
        XRA     A               ;the color (argument 0), if given
        CALL    GWCOL
        LXI     H,CZF8##        ;czgfx draws it
        CALL    CZTFNT##
        LDA     TLEN
        MOV     B,A
        LHLD    TPTR
        CALL    CZTSTR##
        CALL    GRCOL
TXEND:  LHLD    GTXT
        RET
;
TPTR:   DW      0
TLEN:   DB      0
;
        END
