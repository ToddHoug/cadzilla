10 REM SHAPES -- a polygon, PAINT and FLOOD, then CZPOINT reads it back
20 CZINIT
30 DIM P%(11):FOR I=0 TO 5:A=I*6.28318/6
40   P%(2*I)=512+150*COS(A):P%(2*I+1)=384+150*SIN(A):NEXT
50 CZPOLY P%(0),6,255:CZPAINT 512,384,255,128+20
60 PRINT "Painted red: pixel color";CZPOINT(512,384)
70 FOR T=1 TO 300:NEXT:CZFLOOD 512,384,128+20,32+24
80 PRINT "Flooded blue: pixel color";CZPOINT(512,384)
90 CZTEXT 20,CZYMAX-40,"PAINT AND FLOOD",255,3
100 CZWAIT:PRINT "Done."
