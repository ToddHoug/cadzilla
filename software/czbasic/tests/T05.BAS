10 DIM A(10),B%(3,4),C$(5)
20 FOR I=0 TO 10:A(I)=I*I:NEXT
30 FOR I=0 TO 3:FOR J=0 TO 4:B%(I,J)=I*10+J:NEXT J,I
40 PRINT A(10);A(0);B%(3,4);B%(2,1)
50 C$(5)="FIVE":PRINT C$(5);LEN(C$(0))
60 D(5)=7:PRINT D(5);D(10)
70 LONGNAME=1:LONGNAMEX=2:PRINT LONGNAME;LONGNAMEX
80 A=1:A%=2:A!=3:A#=4:A$="5":PRINT A;A%;A!;A#;A$
90 DEFINT I-K:I=7.6:PRINT I
100 DEFSTR S:S="STRING":PRINT S
110 DEFDBL D:D=1/3:PRINT D
120 X=1:Y=2:SWAP X,Y:PRINT X;Y
130 P$="P":Q$="Q":SWAP P$,Q$:PRINT P$;Q$
140 ERASE A:DIM A(3):A(3)=9:PRINT A(3)
150 E(1,1,1)=5:PRINT E(1,1,1)
160 Z%=32767:PRINT Z%
170 AB.CD=12:PRINT AB.CD
180 F=0:F=F+1:F=F*3:PRINT F
190 G#=1/3#:PRINT G#;CSNG(G#);CDBL(1/3)
200 H%=-5.5:PRINT H%;CINT(2.5);CINT(3.5);CINT(-2.5);FIX(-2.7);INT(-2.7);INT(2.7)
210 DIM M(2,2):M(1,2)=3:M(2,1)=4:PRINT M(1,2);M(2,1);M(2,2)
220 SYSTEM
