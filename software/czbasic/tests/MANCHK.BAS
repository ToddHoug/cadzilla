10 REM MANCHK -- the manual's claims about the pen and its examples
20 CZINIT:PRINT "INIT";CZXPOS;CZYPOS
30 CZDOT 11,12:PRINT "DOT";CZXPOS;CZYPOS
40 CZLINE 10,20,30,40:PRINT "LINE";CZXPOS;CZYPOS
50 CZRLINE 5,6:PRINT "RLINE";CZXPOS;CZYPOS
60 CZRECT 100,110,120,130:PRINT "RECT";CZXPOS;CZYPOS
70 CZFRECT 200,210,220,230:PRINT "FRECT";CZXPOS;CZYPOS
80 CZCIRCLE 300,200,50:PRINT "CIRC";CZXPOS;CZYPOS
90 CZELLIPSE 400,300,60,20:PRINT "ELLI";CZXPOS;CZYPOS
100 CZARC 300,300,400,300,300,400:PRINT "ARC";CZXPOS;CZYPOS
110 DIM P%(7):FOR I=0 TO 7:READ P%(I):NEXT:DATA 300,500,400,500,350,600,300,500
120 CZPLINE P%(0),3:PRINT "PLINE";CZXPOS;CZYPOS
130 CZPOLY P%(0),4:PRINT "POLY";CZXPOS;CZYPOS
140 CZMOVE 10,10:CZRMOVE 5,-3:PRINT "RMOVE";CZXPOS;CZYPOS
150 CZPTN 600,600,16,4:PRINT "PTN";CZXPOS;CZYPOS
160 CZCLS:CZFRECT 200,200,300,300,96+31
170 N=0:FOR X=190 TO 310:IF CZPOINT(X,250)<>0 THEN N=N+1
180 NEXT:PRINT N;"CYAN"
190 CZCLS:DIM Q%(11):FOR I=0 TO 5:A=I*6.28318/6
200 Q%(2*I)=512+150*COS(A):Q%(2*I+1)=384+150*SIN(A):NEXT
210 CZPOLY Q%(0),6,255:CZPAINT 512,384,255,128+20:PRINT "PAINT";CZPOINT(512,384);CZPOINT(600,384)
220 CZFLOOD 512,384,128+20,32+24:PRINT "FLOOD";CZPOINT(512,384);CZPOINT(600,384);CZPOINT(662,384)
230 CZCLS:CZMODE 3:CZLINE 512,100,700,600,255:CZLINE 512,100,700,600,255:CZMODE 0
240 PRINT "XOR";CZPOINT(512,100);CZPOINT(606,350)
250 CZCLS:CZCIRCLE 400,400,50,96+31:CZPAINT 400,400,96+31,128+20:CZFLOOD 400,400,128+20,192+31
260 PRINT "PF";CZPOINT(400,400)
270 SYSTEM
