10 OPEN "O",#1,"TF.DAT"
20 PRINT #1,"HELLO";5;"WORLD"
30 WRITE #1,"A,B",3.5,-2
40 PRINT #1,1,2
50 FOR I=1 TO 3:PRINT #1,I*I:NEXT
60 CLOSE #1
70 OPEN "I",#1,"TF.DAT"
80 LINE INPUT #1,A$:PRINT A$
90 INPUT #1,B$,C,D:PRINT B$;C;D
100 INPUT #1,E,F:PRINT E;F
110 WHILE NOT EOF(1):INPUT #1,G:PRINT G;:WEND:PRINT
120 PRINT LOC(1);LOF(1)
130 CLOSE
140 OPEN "R",#2,"TR.DAT",32
150 FIELD #2,10 AS N$,4 AS V$,2 AS W$
160 FOR I=1 TO 5:LSET N$="REC"+STR$(I):LSET V$=MKS$(I*1.5):RSET W$=MKI$(I):PUT #2,I:NEXT
170 GET #2,3:PRINT N$;CVS(V$);CVI(W$)
180 GET #2,1:PRINT N$;CVS(V$);CVI(W$);LOC(2)
190 CLOSE #2
200 PRINT MKI$(16706);CVI("AB");CVD(MKD$(1.25#))
210 KILL "TF.DAT":KILL "TR.DAT"
220 ON ERROR GOTO 300
230 OPEN "I",#1,"NOSUCH.DAT"
240 PRINT "NOT HERE"
250 SYSTEM
300 PRINT "ERR";ERR:RESUME 250
