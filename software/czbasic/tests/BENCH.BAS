10 REM BENCH -- timed sections: run to each "E" marker (t-states)
20 DIM A(100)
100 PRINT "S1":FOR I%=1 TO 2000:J%=I%*2+3:NEXT:PRINT "E1"
200 PRINT "S2":FOR I=1 TO 1000:X=X+I*1.5/3:NEXT:PRINT "E2"
300 PRINT "S3":FOR I=1 TO 300:A$=LEFT$("HELLO WORLD",I MOD 10)+"X":NEXT:PRINT "E3"
400 PRINT "S4":FOR I=1 TO 1000:GOSUB 900:NEXT:PRINT "E4"
500 PRINT "S5":FOR I=0 TO 100:A(I)=I:NEXT:FOR J=1 TO 10:FOR I=0 TO 100:S=S+A(I):NEXT:NEXT:PRINT "E5"
600 PRINT "S6":FOR I=1 TO 100:Y=SIN(I)+SQR(I)+LOG(I):NEXT:PRINT "E6"
700 PRINT X;S;Y:SYSTEM
900 IF I>0 THEN RETURN ELSE RETURN
