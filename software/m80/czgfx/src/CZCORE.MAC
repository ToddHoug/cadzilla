;
; CZCORE.MAC -- czgfx: ACRTC low-level access
;
; Control register writes, the write FIFO, the drawing mode byte, and
; the end-of-drawing wait. Every other czgfx module is built on these.
; See CZGFX.INC for the register conventions.
;
        INCLUDE CZGFX.INC
;
        PUBLIC  CZWREG,CZPUTW,CZWAIT,CZXY,CZSEND,CZRTAB,CZLDW,CZABT
        PUBLIC  CZDM,CZCMD,CZXYM,CZWPR,CZCCR,CZPUTC,CZSTA,CZSTM,CZSTF
;
        CSEG
;
; CZWREG -- write a 16-bit ACRTC control register (8-bit bus mode).
; B = register address (even), HL = value. Even AR takes the high
; byte, odd AR the low byte. AR is set explicitly for both bytes, so
; this works for r00-r7F (no auto-increment) and r80-rFF alike. Leaves
; AR = r00, so the FIFO (CZPUTW) can be used straight afterwards.
;
CZWREG: MOV     A,B
        OUT     ACRSR
        MOV     A,H
        OUT     ACRDAT
        MOV     A,B
        INR     A
        OUT     ACRSR
        MOV     A,L
        OUT     ACRDAT
        XRA     A
        OUT     ACRSR
        RET
;
; CZPUTW -- write the word in HL to the write FIFO, high byte first.
; AR must be r00 (CZINIT and CZWREG leave it there). Waits for WFR.
;
CZPUTW: IN      ACRSR
        ANI     SRWFR
        JZ      CZPUTW
        MOV     A,H
        OUT     ACRDAT
        MOV     A,L
        OUT     ACRDAT
        RET
;
; CZLDW -- DE = word at (HL), HL += 2
;
CZLDW:  MOV     E,M
        INX     H
        MOV     D,M
        INX     H
        RET
;
; CZSEND -- send BC words from the table at HL to the FIFO (BC > 0).
; Returns HL past the table, BC = 0. Clobbers DE.
;
CZSEND: CALL    CZLDW
        XCHG
        CALL    CZPUTW
        XCHG
        DCX     B
        MOV     A,B
        ORA     C
        JNZ     CZSEND
        RET
;
; CZWAIT -- wait until the write FIFO is empty and the last command
; has ended. Returns A = status register, Z set if no command error.
;
CZWAIT: PUSH    B
WAITLP: IN      ACRSR
        MOV     B,A
        ANI     SRWFE
        JZ      WAITLP
        MOV     A,B
        ANI     SRCED
        JZ      WAITLP
        MOV     A,B
        ANI     SRCER
        MOV     A,B
        POP     B
        RET
;
; Stop modes. Once AMSTOP or AMSTPI (AREA 001, 101) has cut a command
; short, the real HD63484 ignores everything after it -- commands,
; WPRs, RPRs -- until it is aborted, and sets no ARD to say so. So a
; drawing command sent in a stop mode sets CZSTF (CZSTM), and the start
; of the next command waits for it to end and aborts (CZSTA), which
; keeps the CP and the drawing parameters. Every command word goes out
; through CZCMD, CZXY, CZWPR or CZPUTC, which call CZSTA first.
;
; CZSTA -- if CZSTF, wait for the drawing to end, then CZABT (which
; clears CZSTF). Preserves all registers.
;
CZSTA:  PUSH    PSW
        LDA     CZSTF
        ORA     A
        JZ      STA1
        CALL    CZWAIT
        CALL    CZABT
STA1:   POP     PSW
        RET
;
; CZSTM -- set CZSTF if the drawing mode's AREA is a stop mode.
; Clobbers A.
;
CZSTM:  LDA     CZDM
        ANI     60H             ;AREA bits 1-0 = 01: 001 or 101
        CPI     20H
        RNZ
        STA     CZSTF
        RET
;
; CZPUTC -- CZPUTW for a command word: CZSTA first
;
CZPUTC: CALL    CZSTA
        JMP     CZPUTW
;
; CZXY -- send graphic command A (command high byte) with parameters
; X = HL, Y = DE.
;
CZXY:   CALL    CZSTA
        PUSH    H
        MOV     H,A
        MVI     L,0
        CALL    CZPUTW
        POP     H
        CALL    CZPUTW
        XCHG
        CALL    CZPUTW
        XCHG
        RET
;
; CZCMD -- send the drawing command with high byte A and the current
; drawing mode (CZDM) as its low byte. Clobbers A.
;
CZCMD:  CALL    CZSTA
        PUSH    H
        MOV     H,A
        LDA     CZDM
        MOV     L,A
        CALL    CZPUTW
        POP     H
        JMP     CZSTM
;
; CZXYM -- as CZXY, the command carrying the drawing mode
;
CZXYM:  CALL    CZCMD
        CALL    CZPUTW
        XCHG
        CALL    CZPUTW
        XCHG
        RET
;
; CZWPR -- write drawing parameter register A (WPR: 0 CL0, 1 CL1,
; 2 CCMP, 3 EDG, 4 MASK, 5-7 PRC, 8-0BH area, 0CH-0DH RWP) with HL
;
CZWPR:  CALL    CZSTA
        PUSH    H
        MVI     H,08H
        MOV     L,A
        CALL    CZPUTW
        POP     H
        JMP     CZPUTW
;
; CZDM -- the drawing mode, AREA (bits 7-5) COL (4-3) OPM (2-0), the
; low byte of every drawing command. GINIT sets 0 (replace, CMSEL,
; no area checking); GMODE and CZMODE.MAC's routines change it.
;
CZDM:   DB      0
;
; CZRTAB -- load ACRTC control registers from the table at HL.
; Entries: DB register / DW value; DB 0FFH ends. Returns HL past it.
;
CZRTAB: PUSH    B
        PUSH    D
RTLOOP: MOV     A,M
        INX     H
        CPI     0FFH
        JZ      RTDONE
        MOV     B,A
        CALL    CZLDW
        XCHG
        CALL    CZWREG
        XCHG
        JMP     RTLOOP
RTDONE: POP     D
        POP     B
        RET
;
; CZABT -- abort: stop drawing, flush the FIFOs and clear a command
; error and ARD (CCR ABT), keeping the pixel depth (CZCCR) and no
; interrupts. The CP and the drawing parameters are kept.
;
CZABT:  PUSH    B
        PUSH    H
        MVI     B,02H
        LDA     CZCCR
        ORI     80H             ;ABT
        MOV     H,A
        MVI     L,0
        CALL    CZWREG
        LDA     CZCCR
        MOV     H,A
        CALL    CZWREG
        XRA     A               ;no stop pending now
        STA     CZSTF
        POP     H
        POP     B
        RET
;
; CZCCR -- CCR's high byte as the library last set it: 03H (GBM=011,
; 8 bpp, the frame) or 00H (1 bpp, the overlay). CZINIT, CZOVL and
; CZFRM keep it.
;
CZCCR:  DB      03H
;
; CZSTF -- nonzero once a command has gone out in a stop mode
;
CZSTF:  DB      0
;
        END
