10 REM CZDEMO -- a tour of CZBASIC's CADzilla statements
20 REM Pixels, 0,0 at the bottom left; colors are hue*32+level
30 REM (hues 0 orange, 32 blue, 64 green, 96 cyan, 128 red,
40 REM 160 magenta, 192 yellow, 224 white; levels 0 to 31)
50 CZINIT:W=CZXMAX:H=CZYMAX:CX=W\2:CY=H\2
100 REM -- 1: lines from the centre, a frame and a title
110 CZRECT 0,0,W,H,255
120 FOR I=0 TO 63:A=I*6.28318/64
130 CZLINE CX,CY,CX+300*COS(A),CY+300*SIN(A),(I MOD 8)*32+31:NEXT
140 CZTEXT 20,H-40,"CZBASIC ON CADZILLA",255,3
150 GOSUB 900
200 REM -- 2: circles, ellipses and an arc
210 CZCLS
220 FOR R=20 TO 360 STEP 20:CZCIRCLE CX,CY,R,64+R\12:NEXT
230 FOR I=1 TO 8:CZELLIPSE CX,CY,40*I,15*I,160+3*I:NEXT
240 CZARC 150,150,250,150,150,250,192+31
250 CZTEXT 20,H-40,"CIRCLES, ELLIPSES AND ARCS",224+31,2
260 GOSUB 900
300 REM -- 3: filled boxes, a polygon and PAINT
310 CZCLS
320 FOR I=0 TO 7:CZFRECT 40+I*120,60,140+I*120,260,I*32+31:NEXT
330 DIM P%(11):FOR I=0 TO 5:A=I*6.28318/6
340 P%(2*I)=CX+150*COS(A):P%(2*I+1)=CY+120+150*SIN(A):NEXT
350 CZPOLY P%(0),6,255:CZPAINT CX,CY+120,255,128+20
360 CZTEXT 20,H-40,"BOXES, A POLYGON AND PAINT",224+31,2
370 GOSUB 900
400 REM -- 4: text sizes and directions, then a palette cycle
410 CZCLS
420 FOR S=1 TO 4:CZTEXT 20,H-60-S*50,"SCALE"+STR$(S),192+31,S:NEXT
430 FOR D=0 TO 7:CZTEXT CX,CY,"  DIRECTION",96+31,2,D:NEXT
440 FOR K=0 TO 31:CZPAL 255,K*8,255-K*8,128:NEXT:CZPAL
450 GOSUB 900
460 CZCLS:PRINT "Done.":END
900 CZWAIT:PRINT "Press a key...";
910 IF INKEY$="" THEN 910
920 PRINT:RETURN
