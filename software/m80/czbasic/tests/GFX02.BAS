10 REM GFX02 -- draw, then read pixels back with CZPOINT
20 CZINIT 1024:CZCOLOR 1
30 CZLINE 10,20,50,20,5:CZLINE 60,20,60,40,6
40 CZRECT 100,100,120,110,7
50 CZFRECT 200,200,210,210,9
60 CZCIRCLE 400,400,50,11:CZPAINT 400,400,11,13
70 CZCOPY 200,200,210,210,300,200
80 CZTEXT 500,500,"I",15:CZTEXT 600,500,"I",15,2
90 CZDOT 1023,767,17:CZDOT 0,0,18:CZDOT 1,0,19
100 CZMODE 3:CZFRECT 205,205,206,206,9:CZMODE 0
110 CZELLIPSE 800,300,60,20,21
120 CZTEXT 500,600,"AB",23,1,2
130 CZWAIT:F=0
140 READ N$:IF N$="END" THEN 210
150 READ X,Y,E:P=CZPOINT(X,Y)
160 IF P<>E THEN PRINT "BAD ";N$;X;Y;"got";P;"want";E:F=F+1
170 GOTO 140
210 PRINT "FAILS";F
220 SYSTEM
300 DATA hline,10,20,5,hline,50,20,5,hline,51,20,0,vline,60,40,6,vline,60,41,0,hline,30,20,5,hline,9,20,0,vline,60,20,6,vline,60,30,6
