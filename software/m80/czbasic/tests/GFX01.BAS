10 REM GFX01 -- every CZ statement once
20 CZINIT 1024
30 CZCOLOR 224+31
40 CZRECT 0,0,CZXMAX,CZYMAX
50 CZLINE 0,0,CZXMAX,CZYMAX,128+31
60 CZLINE TO 100,700
70 CZRLINE 50,-50,64+31
80 CZFRECT 100,100,200,200,32+31
90 CZCIRCLE 512,384,100,192+31
100 CZELLIPSE 512,384,200,80,96+31
110 CZARC 800,200,850,200,800,250,160+31
120 CZEARC 800,600,40,20,880,600,800,640,0+31,1
130 DIM P%(7):FOR I=0 TO 7:READ P%(I):NEXT:DATA 300,500,400,500,350,600,300,500
140 CZPOLY P%(0),4,64+20
150 CZPLINE P%(0),3,64+31
160 CZRECT 600,100,700,160,224+31:CZPAINT 650,130,224+31,32+15
170 CZDOT 10,10,255:CZDOT 11,10
180 PRINT CZPOINT(10,10);CZPOINT(11,10);CZPOINT(150,150);CZPOINT(500,20)
190 CZMOVE 5,6:PRINT CZXPOS;CZYPOS;CZXMAX;CZYMAX
200 CZTEXT 20,720,"CZBASIC ON CADZILLA",224+31,2
210 CZTEXT 20,650,"Scale 1 text: 0123456789 !?@#",192+31
220 CZCOPY 100,100,200,200,250,100
230 CZPAL 1,255,0,0:CZPAL
240 CZMODE 3:CZFRECT 400,300,450,350,255:CZMODE 0
250 CZAREA 0,0,CZXMAX,CZYMAX:CZAREA
260 CZPAT 0,&HAAAA,&H5555:CZPSCAN 0,0,15,1:CZFRECT 20,300,80,360,224+31
270 CZPAT 0,-1,-1:CZPSCAN 0,0,15,15:CZLSTYLE &HF0F0:CZLINE 20,400,300,400:CZLSTYLE -1
280 CZPTN 900,700,16,16
290 CZWAIT
300 PRINT "DONE"
310 SYSTEM
