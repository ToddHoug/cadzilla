10 REM GBENCH -- CZ statement timing: run to each "E" marker (t-states)
20 CZINIT:Y=200:C=5
30 PRINT "S1":FOR I=1 TO 300:CZLINE 10,10,500,400,7:NEXT:PRINT "E1"
40 PRINT "S2":FOR I=1 TO 300:CZDOT I,Y,C:NEXT:PRINT "E2"
50 PRINT "S3":FOR I=1 TO 300:P=CZPOINT(I,Y):NEXT:PRINT "E3"
60 PRINT "S4":FOR I=1 TO 50:CZTEXT 10,10,"HELLO",255:NEXT:PRINT "E4"
70 PRINT P:SYSTEM
