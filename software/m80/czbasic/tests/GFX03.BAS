10 REM GFX03 -- CZPOINT in every mode: dots read back, odd and even x
20 F=0:FOR M=1 TO 3:READ W:CZINIT W:XM=CZXMAX:YM=CZYMAX
30 RESTORE 200:FOR K=1 TO 6:READ X,Y,C
40 IF X<0 THEN X=XM
50 IF Y<0 THEN Y=YM
60 CZDOT X,Y,C:NEXT
70 RESTORE 200:FOR K=1 TO 6:READ X,Y,C
80 IF X<0 THEN X=XM
90 IF Y<0 THEN Y=YM
100 P=CZPOINT(X,Y):IF P<>C THEN PRINT "BAD";W;X;Y;P;C:F=F+1
110 NEXT:IF CZPOINT(XM+1,0)<>-1 OR CZPOINT(0,YM+1)<>-1 THEN PRINT "EDGE";W:F=F+1
120 RESTORE 190:FOR J=1 TO M:READ W:NEXT:NEXT
130 PRINT "MODES";XM;YM;"FAILS";F:CZINIT:SYSTEM
180 DATA 640,800,1024
190 DATA 640,800,1024
200 DATA 0,0,11,1,0,12,-1,-1,13,300,200,14,301,200,15,-1,0,16
